# Undock: back straight on /pre_cmd_vel until the tag is distance_m ahead of the
# camera, then restore AMCL / lidar safety. Accepted only in IDLE; stop it with
# an action cancel.
# Goal
int32   tag_id       # -1 = any id (whatever apriltag_detection tracks); >= 0 = that id, must match tracking_tag_id
string  tag_family   # must match apriltag_detection's tracking_tag_family, else TAG_LOST
float32 distance_m   # m, camera-to-tag forward distance to back up to; must be > 0
---
# Result
bool    success
uint8   error_code
string  message
float32 final_x_error    # m   forward (control frame), relative to distance_m; NaN if never seen
float32 final_y_shift    # m   monitor only
float32 final_yaw_shift  # rad monitor only

# y / yaw shift: undock has no y / yaw target (it backs straight and only checks
# x), so these are not errors. They are the measured lateral / heading shift from
# the tag's centre line, for monitoring only; they never affect success,
# error_code or when the robot stops.



uint8 OK = 0
uint8 TAG_LOST = 1            # tag not seen for lost_target_timeout (launch parameter, default 1 s) while running
uint8 AMCL_SERVICE_FAIL = 2   # AMCL service missing / no response / wrong state; also when the restore fails
uint8 LIDAR_SERVICE_FAIL = 3  # reserved, not reported yet (lidar safety is fire-and-forget)
uint8 TIMEOUT = 4             # undock_timeout (launch parameter) from goal accepted until ending
uint8 ACTION_CANCELED = 5     # action cancel
uint8 OTHER = 6               # any other failure
uint8 NODE_SHUTDOWN = 7       # apriltag_control shut down
---
# Feedback (fixed 10 Hz timer, not tied to camera frames; also a heartbeat)
uint32 seq                     # per goal, from 0
builtin_interfaces/Time stamp  # node clock when published
uint8   stage                  # STAGE_PREPARING / STAGE_LEAVING / STAGE_FINISHING
float32 x_error                # m, forward - distance_m (stops at >= 0); NaN if no data
float32 y_shift                # m,   monitor only (see Result); NaN if no data
float32 yaw_shift              # rad, monitor only (see Result); NaN if no data
float32 last_frame_age         # s, now - header.stamp of the newest frame with the tracked tag; NaN if none

uint8 STAGE_PREPARING = 0
uint8 STAGE_LEAVING = 1
uint8 STAGE_FINISHING = 2
